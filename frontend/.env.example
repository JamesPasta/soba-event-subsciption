# Frontend environment variables — localhost / local dev
# Runtime auth config is loaded from the backend `/meta/frontend-config` endpoint.
# This fallback is used to locate the backend when runtime config is requested.

# Use localhost so the app works from a browser on the host (http://localhost:3000).
NEXT_PUBLIC_SOBA_API_BASE_URL=http://localhost:4000/chefs/api/v1

# Optional: Next.js server only. In Docker Compose use the backend service name, e.g.:
# SOBA_API_INTERNAL_URL=http://backend:4000/chefs/api/v1

# Feature allowlist for this frontend deployment (codes from GET /meta/features).
# Also injected into the page at runtime (window.__SOBA_FEATURES_ALLOWED) so Docker images see compose env without rebuilding.
# Use * or all to allow every platform-allowed feature. Empty/unset = none (explicit list or wildcard required).
# Common codes: design-mode, submit-mode, files, meta.
# meta enables the optional /meta page (health + API meta JSON).
# Example submit-only: submit-mode
# Example with meta review: design-mode,submit-mode,meta
NEXT_PUBLIC_SOBA_FEATURES_ALLOWED=*

# Public URLs of the two frontend apps: designer is staff/design-mode, forms is submitter/submit-mode.
# Injected into the page at runtime (window.__SOBA_*) and used as the fallback when the backend does
# not report them. Unset falls back to this app's own URL, which is what one deployment serving
# both modes needs, so leave these unset for pnpm dev:combined.
# NEXT_PUBLIC_SOBA_DESIGNER_APP_URL=http://localhost:3101/designer
# NEXT_PUBLIC_SOBA_FORMS_APP_URL=http://localhost:3100/forms

# URL path the app is served under, baked at build time by next.config.ts. The dev scripts set it:
# dev:combined /chefs on :3000, dev:forms /forms on :3100, dev:designer /designer on :3101.
# BASE_PATH=
